# Salin file ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.

# API key Gemini dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Suara Gemini hanya aktif bila bernilai 1 DAN akun punya kuota TTS berbayar.
# Free Tier hanya 3 request/menit dan 10 request/hari, sehingga suara jadi bercampur.
# Biarkan 0 untuk memakai suara browser yang konsisten.
GEMINI_TTS_ENABLED=0
NEXT_PUBLIC_SUARA_AWAN=0

# Model suara (TTS). Pilihan: gemini-3.8-flash-lite-tts (cepat), gemini-3.8-flash-tts (lebih kaya)
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Model teks untuk Copilot, triase, ringkasan, cerita, tanya Boni, dan simulasi.
# Rantai model teks (dicoba berurutan bila kuota habis). Flash-Lite 2-3x lebih cepat (4-5 dtk vs 11-12 dtk).
# Batas Free Tier berlaku per model.
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Konfigurasi web Firebase (Console > Project settings > Your apps). Nilai ini pengenal publik;
# keamanan data diatur oleh firestore.rules, bukan dengan menyembunyikannya.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Isi 1 untuk memakai Firebase Emulator di komputer sendiri (tanpa menyentuh proyek cloud).
NEXT_PUBLIC_FIREBASE_EMULATOR=
